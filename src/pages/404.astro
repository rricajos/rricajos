---
import Base from '../layouts/Base.astro';
---

<Base title="404 — ricajos">
  <div class="page">
    <h1>404</h1>
    <p class="msg" id="msg-404">Aquí no hay nada.</p>
    <a href="/" class="back" id="back-404">Volver a ricajos.com</a>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--muted);
  }

  .msg {
    font-size: 1.125rem;
    color: var(--text-2);
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 0.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .back:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>

<script>
  const t = {
    es: { msg: 'Aquí no hay nada.', back: 'Volver a ricajos.com' },
    en: { msg: 'Nothing here.', back: 'Back to ricajos.com' },
    zh: { msg: '这里什么也没有。', back: '返回 ricajos.com' },
  };

  const raw = navigator.language?.split('-')[0] || 'es';
  const lang = ['es', 'en', 'zh'].includes(raw) ? raw : 'en';

  try {
    const saved = localStorage.getItem('lang');
    if (saved && t[saved]) {
      document.getElementById('msg-404').textContent = t[saved].msg;
      document.getElementById('back-404').textContent = t[saved].back;
    } else if (t[lang]) {
      document.getElementById('msg-404').textContent = t[lang].msg;
      document.getElementById('back-404').textContent = t[lang].back;
    }
  } catch {}
</script>
