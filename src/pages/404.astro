---
import Base from '../layouts/Base.astro';
---

<Base title="404 — ricajos">
  <div class="page">
    <h1>404</h1>
    <p>Nothing here.</p>
    <a href="/">Back to ricajos.com</a>
  </div>
</Base>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    padding: 2rem;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--muted);
  }

  p {
    font-size: 1.125rem;
    color: var(--text-2);
  }

  a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 0.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  a:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
