---
import Base from '../layouts/Base.astro';
---

<Base title="ricajos — Full-stack builder, Barcelona">
  <!-- Nav -->
  <header>
    <div class="wrap nav-inner">
      <a href="/" class="logo">ricajos</a>
      <nav>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <h1>ricajos<span class="cursor"></span></h1>
      <p class="lead">
        Full-stack builder, Barcelona. I design, build, and ship web products
        — from the database schema to the deploy pipeline.
      </p>
      <a href="#projects" class="cta">
        See what I've built
        <svg
          class="arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg
        >
      </a>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="wrap reveal">
      <p class="label">Projects</p>
      <h2 class="heading">What I've built</h2>
      <div class="grid">
        <div class="card">
          <div class="card-name"><span class="dot"></span>pingunix</div>
          <p class="card-desc">
            Study platform for LPIC certification. 821 pages of content with
            PWA-powered flashcards.
          </p>
          <div class="tags">
            <span class="tag">Quartz</span>
            <span class="tag">PWA</span>
            <span class="tag">GitHub Pages</span>
          </div>
        </div>
        <div class="card">
          <div class="card-name"><span class="dot"></span>darink</div>
          <p class="card-desc">
            Offline-first health tracker. Food, exercise, sleep, and vitals —
            works without a connection.
          </p>
          <div class="tags">
            <span class="tag">PWA</span>
            <span class="tag">IndexedDB</span>
            <span class="tag">Offline-first</span>
          </div>
        </div>
        <div class="card">
          <div class="card-name"><span class="dot"></span>planetlogin</div>
          <p class="card-desc">
            White-label authentication portal. Stateless login you drop into any
            app.
          </p>
          <div class="tags">
            <span class="tag">SvelteKit</span>
            <span class="tag">Auth</span>
            <span class="tag">Stateless</span>
          </div>
        </div>
      </div>
      <p class="more">More products shipping soon.</p>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="wrap reveal">
      <p class="label">About</p>
      <h2 class="heading">How I work</h2>
      <div class="two-col">
        <div class="prose">
          <p>
            I'm Ricard — a developer who likes owning the full picture. Most of
            my projects run on infrastructure I manage myself, from the Docker
            Swarm cluster to the CI/CD pipelines that ship code on every push.
          </p>
          <p>
            I build products, not just features. Every project in this portfolio
            is something I conceived, designed, and shipped end-to-end. When I
            work with clients, I bring the same ownership mindset.
          </p>
        </div>
        <ul class="stack">
          <li>SvelteKit <span class="role">framework</span></li>
          <li>Prisma <span class="role">ORM</span></li>
          <li>PostgreSQL <span class="role">database</span></li>
          <li>Docker Swarm <span class="role">orchestration</span></li>
          <li>GitHub Actions <span class="role">CI/CD</span></li>
          <li>Linux / VPS <span class="role">infrastructure</span></li>
          <li>Node.js <span class="role">runtime</span></li>
          <li>Python <span class="role">scripting</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section">
    <div class="wrap reveal">
      <h2 class="contact-heading">Let's build something.</h2>
      <p class="contact-sub">
        Got a project in mind? Open to freelance work and interesting
        collaborations.
      </p>

      <form
        class="contact-form"
        action="https://formsubmit.co/ergoegos@gmail.com"
        method="POST"
      >
        <input
          type="hidden"
          name="_subject"
          value="New message from ricajos.com"
        />
        <input type="hidden" name="_captcha" value="false" />
        <input
          type="hidden"
          name="_next"
          value="https://ricajos.com/#contact"
        />
        <input
          type="text"
          name="_honey"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name</label>
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Your name"
              required
            />
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="you@example.com"
              required
            />
          </div>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea
            id="message"
            name="message"
            placeholder="Tell me about your project..."
            rows="4"
            required
            maxlength="2000"></textarea>
        </div>
        <button type="submit" class="submit-btn">Send message</button>
      </form>

      <div class="social-links">
        <a href="mailto:ergoegos@gmail.com" target="_blank" rel="noopener"
          >Email</a
        >
        <span class="social-sep">·</span>
        <a href="https://github.com/rricajos" target="_blank" rel="noopener"
          >GitHub</a
        >
        <span class="social-sep">·</span>
        <a href="https://x.com/rricajos" target="_blank" rel="noopener">X</a>
        <span class="social-sep">·</span>
        <a
          href="https://linkedin.com/in/rricajos"
          target="_blank"
          rel="noopener">LinkedIn</a
        >
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="wrap">
      <p>ricajos &mdash; Barcelona</p>
    </div>
  </footer>
</Base>

<style>
  .wrap {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Nav ── */
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  nav a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* ── Hero ── */
  .hero {
    min-height: calc(100dvh - 3.25rem);
    display: flex;
    align-items: center;
    background-image: radial-gradient(
      circle,
      var(--dot) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.78em;
    background: var(--accent);
    margin-left: 0.06em;
    vertical-align: baseline;
    border-radius: 1px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .lead {
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    font-weight: 300;
    color: var(--text-2);
    margin-top: 1.5rem;
    max-width: 520px;
    line-height: 1.55;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .arrow {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }

  .cta:hover .arrow {
    transform: translateY(2px);
  }

  /* ── Sections ── */
  section {
    padding: 5rem 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .heading {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 2.5rem;
  }

  /* ── Projects ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-hover);
    transform: translateY(-3px);
  }

  .card-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.175rem 0.45rem;
    border-radius: 4px;
  }

  .more {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── About ── */
  .two-col {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: start;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-2);
  }

  .prose p + p {
    margin-top: 1rem;
  }

  .stack {
    list-style: none;
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.5625rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stack li:first-child {
    border-top: 1px solid var(--border);
  }

  .role {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  /* ── Contact ── */
  .contact-section {
    text-align: center;
    padding: 6rem 0 3rem;
  }

  .contact-heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 0.75rem;
  }

  .contact-sub {
    color: var(--text-2);
    font-size: 1rem;
    margin-bottom: 2.5rem;
  }

  .contact-form {
    max-width: 520px;
    margin: 0 auto;
    text-align: left;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .contact-form label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.375rem;
    letter-spacing: 0.02em;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.15s;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--accent);
    outline: none;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--accent);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover {
    background: var(--accent-hover);
  }

  .social-links {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .social-sep {
    color: var(--muted);
    user-select: none;
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
    text-align: center;
  }

  footer p {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    section {
      padding: 3.5rem 0;
    }
    .contact-section {
      padding: 4rem 0 2.5rem;
    }
  }

  @media (max-width: 480px) {
    nav a {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
    .logo {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
    .card,
    .cta,
    nav a,
    .submit-btn {
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
