    .scroll-indicator { animation: none; }
    .hero-text > *, .hero-globe { opacity: 1; animation: none; transform: none; }
    .card, .cta, nav a, .submit-btn, [data-i18n], .theme-toggle, .site-header, .logo { transition: none; }
    [data-i18n].i18n-out { transform: none; }
