---
import Base from '../layouts/Base.astro';
---

<Base title="ricajos — Ricard Penin Honrubia, desarrollador full-stack en Barcelona">
  <a href="#projects" class="skip-link" data-i18n="a11y.skip">Ir al contenido</a>

  <header class="site-header" id="site-header">
    <div class="wrap nav-inner">
      <a href="/" class="logo">ricajos</a>
      <div class="nav-right">
        <nav>
          <a href="#projects" data-i18n="nav.projects" data-section="projects">Proyectos</a>
          <a href="#about" data-i18n="nav.about" data-section="about">Sobre mí</a>
          <a href="#contact" data-i18n="nav.contact" data-section="contact">Contacto</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>ricajos<span class="typed" id="typed"></span><span class="cursor"></span></h1>
        <p class="lead" data-i18n="hero.lead">
          Tu producto web en producción — diseño, código, infra y deploy.
          Una sola persona, cero excusas.
        </p>
        <a href="#contact" class="cta">
          <span data-i18n="hero.cta">Hablemos de tu proyecto</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
        </a>
      </div>
      <div class="hero-globe">
        <planet-login accent="#34d399" search="false" data-url="/countries-110m.json"></planet-login>
        <p class="globe-hint" data-i18n="hero.globe_hint">Haz clic en un país para cambiar el idioma</p>
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </section>

  <section id="projects">
    <div class="wrap reveal">
      <p class="label" data-i18n="projects.label">Proyectos</p>
      <h2 class="heading" data-i18n="projects.heading">Lo que he construido</h2>
      <div class="grid">
        <a href="https://github.com/rricajos/pingunix" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name"><span class="dot"></span>pingunix</div>
            <span class="badge badge-live">live</span>
          </div>
          <p class="card-metric" data-i18n="projects.pingunix_metric">821 páginas · PWA con flashcards</p>
          <p class="card-desc" data-i18n="projects.pingunix">
            Construí mi propia plataforma de estudio para LPIC porque las que
            había eran lentas y no funcionaban offline. Quartz v5, estática,
            se carga al instante.
          </p>
          <div class="tags">
            <span class="tag">Quartz</span>
            <span class="tag">PWA</span>
            <span class="tag">GitHub Pages</span>
          </div>
        </a>
        <a href="https://github.com/rricajos/darink" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name"><span class="dot"></span>darink</div>
            <span class="badge badge-wip">wip</span>
          </div>
          <p class="card-metric" data-i18n="projects.darink_metric">100% offline · IndexedDB local</p>
          <p class="card-desc" data-i18n="projects.darink">
            App de salud que funciona sin internet. Registro de alimentación,
            ejercicio, sueño y constantes — tus datos se quedan en tu
            dispositivo, no en un servidor.
          </p>
          <div class="tags">
            <span class="tag">PWA</span>
            <span class="tag">IndexedDB</span>
            <span class="tag">Offline-first</span>
          </div>
        </a>
        <a href="https://github.com/rricajos/planetlogin" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name"><span class="dot"></span>planetlogin</div>
            <span class="badge badge-live">live</span>
          </div>
          <p class="card-metric" data-i18n="projects.planetlogin_metric">Publicado en npm · Lo estás viendo arriba</p>
          <p class="card-desc" data-i18n="projects.planetlogin">
            Componente web de login con un globo interactivo — el que has visto
            en el hero. Una línea de HTML y tu app tiene autenticación con
            selector de país.
          </p>
          <div class="tags">
            <span class="tag">Web Component</span>
            <span class="tag">npm</span>
            <span class="tag">Canvas</span>
          </div>
        </a>
      </div>
      <div class="proof">
        <div class="proof-item">
          <span class="proof-num">3</span>
          <span class="proof-label" data-i18n="projects.proof_products">productos en producción</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">821</span>
          <span class="proof-label" data-i18n="projects.proof_pages">páginas publicadas</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">0</span>
          <span class="proof-label" data-i18n="projects.proof_downtime">downtime en deploys</span>
        </div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap reveal">
      <p class="label" data-i18n="about.label">Sobre mí</p>
      <h2 class="heading" data-i18n="about.heading">De la idea al servidor</h2>
      <div class="about-grid">
        <div class="prose">
          <p data-i18n="about.p1">
            Monto toda mi infra en un VPS de 9 euros. No es por ahorrar — es
            porque cuando controlas el servidor, controlas los plazos. Un
            <code>git push</code> y está en producción, sin tickets ni esperas.
          </p>
          <p data-i18n="about.p2">
            Cada proyecto de este portfolio lo construí porque lo necesitaba y
            lo que había no me convencía. Esa es mi forma de trabajar: si el
            problema es real, la solución sale sola.
          </p>
          <p data-i18n="about.p3">
            Busco clientes que quieran un solo responsable de principio a fin.
            Tú me cuentas qué necesitas, yo te entrego el producto desplegado,
            con dominio, HTTPS y un pipeline que se actualiza solo. Sin
            coordinar tres equipos, sin reuniones innecesarias.
          </p>
        </div>
        <div class="about-aside">
          <div class="about-block">
            <p class="about-block-label" data-i18n="about.stack_label">Stack principal</p>
            <ul class="stack-compact">
              <li>SvelteKit</li>
              <li>Astro</li>
              <li>Node.js</li>
              <li>PostgreSQL</li>
              <li>Prisma</li>
              <li>Docker Swarm</li>
              <li>Linux / VPS</li>
              <li>GitHub Actions</li>
            </ul>
          </div>
          <div class="about-block">
            <p class="about-block-label" data-i18n="about.also_label">También trabajo con</p>
            <ul class="stack-compact secondary">
              <li>Python</li>
              <li>Go</li>
              <li>PowerShell</li>
              <li>Bash</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="wrap reveal">
      <h2 class="contact-heading" data-i18n="contact.heading">¿Tienes algo que necesita salir?</h2>
      <p class="contact-sub" data-i18n="contact.sub">
        Cuéntame qué quieres construir. Si encaja, en 48h tienes una
        propuesta con alcance, stack y timeline.
      </p>
      <form class="contact-form" action="https://formsubmit.co/ergoegos@gmail.com" method="POST">
        <input type="hidden" name="_subject" value="New message from ricajos.com" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://ricajos.com/#contact" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-row">
          <div class="form-group">
            <label for="name" data-i18n="form.name">Nombre</label>
            <input id="name" type="text" name="name" data-i18n-placeholder="form.name_ph" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email" data-i18n="form.email">Email</label>
            <input id="email" type="email" name="email" placeholder="tu@ejemplo.com" data-i18n-placeholder="form.email_ph" required />
          </div>
        </div>
        <div class="form-group">
          <label for="message" data-i18n="form.message">Mensaje</label>
          <textarea id="message" name="message" data-i18n-placeholder="form.message_ph" placeholder="Cuéntame sobre tu proyecto..." rows="4" required maxlength="2000"></textarea>
        </div>
        <button type="submit" class="submit-btn" data-i18n="form.send">Enviar mensaje</button>
      </form>
      <div class="social-links">
        <a href="mailto:ergoegos@gmail.com" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>
        <span class="social-sep">·</span>
        <a href="https://github.com/rricajos" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
        <span class="social-sep">·</span>
        <a href="https://instagram.com/rricajos" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          Instagram
        </a>
        <span class="social-sep">·</span>
        <a href="https://linkedin.com/in/rricajos" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <p>&copy; <span id="year"></span> ricajos &mdash; Barcelona</p>
    </div>
  </footer>

  <script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@planetlogin/planetlogin@0.3.0/dist/planetlogin.js"></script>
</Base>

<style>
  .wrap {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Skip link ── */
  .skip-link {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 10000;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--bg);
    background: var(--accent);
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }

  /* ── Fixed header ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .site-header.scrolled {
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: #cdd1e4;
    text-decoration: none;
    letter-spacing: -0.03em;
    transition: color 0.3s;
  }

  .site-header.scrolled .logo {
    color: var(--text);
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #8b90ad;
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }

  nav a:hover {
    color: #34d399;
    background: rgba(52, 211, 153, 0.06);
  }

  nav a.active {
    color: #34d399;
  }

  .site-header.scrolled nav a {
    color: var(--text-2);
  }

  .site-header.scrolled nav a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .site-header.scrolled nav a.active {
    color: var(--accent);
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
    color: #8b90ad;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .theme-toggle:hover {
    color: #34d399;
    background: rgba(52, 211, 153, 0.06);
  }

  .site-header.scrolled .theme-toggle {
    color: var(--text-2);
  }

  .site-header.scrolled .theme-toggle:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .icon-sun,
  .icon-moon {
    display: none;
  }

  /* ── Hero ── */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #070b16;
    color: #cdd1e4;
    position: relative;
    overflow: hidden;
    padding: 3.25rem 0 0;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1px 1px at 15% 85%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,0.2) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 15%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 95%, rgba(255,255,255,0.15) 0%, transparent 100%),
      radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.3) 0%, transparent 100%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
    flex: 1;
    position: relative;
  }

  .hero-text {
    min-width: 0;
  }

  .hero-globe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    position: relative;
  }

  .hero-globe planet-login {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 420px;
  }

  .globe-hint {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #6d728f;
    text-align: center;
    font-style: italic;
    opacity: 0;
    transition: opacity 0.3s ease;
    margin-top: 0.25rem;
  }

  .hero-globe:hover .globe-hint {
    opacity: 1;
  }

  .hero-globe planet-login > a[href*="ricajos"] {
    display: none;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .typed {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.78em;
    background: var(--accent);
    margin-left: 0.06em;
    vertical-align: baseline;
    border-radius: 1px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .lead {
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    font-weight: 300;
    color: #8b90ad;
    margin-top: 1.5rem;
    max-width: 520px;
    line-height: 1.55;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #34d399;
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border: 1px solid #34d399;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: #34d399;
    color: #070b16;
  }

  .arrow {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }

  .cta:hover .arrow {
    transform: translateY(2px);
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: #6d728f;
    animation: bounce 2.5s ease infinite;
    transition: opacity 0.4s;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  /* ── Hero entrance animation ── */
  .hero-text > * {
    opacity: 0;
    animation: heroIn 0.7s ease forwards;
  }

  .hero-text h1 { animation-delay: 0s; }
  .hero-text .lead { animation-delay: 0.15s; }
  .hero-text .cta { animation-delay: 0.3s; }

  .hero-globe {
    opacity: 0;
    animation: heroIn 0.8s ease 0.1s forwards;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Sections ── */
  section {
    padding: 5rem 0;
  }

  section[id] {
    scroll-margin-top: 4rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .heading {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 2.5rem;
  }

  /* ── Projects ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .grid .card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    text-decoration: none;
