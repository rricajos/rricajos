  const langMap = {
    es: 'es', ca: 'es', gl: 'es', eu: 'es',
    en: 'en',
    zh: 'zh', 'zh-CN': 'zh', 'zh-TW': 'zh',
  };

  let currentLang = 'es';

  function setLang(lang, animate) {
    if (lang === currentLang && animate) return;
    currentLang = lang;
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang;

    const els = document.querySelectorAll('[data-i18n]');
    const phEls = document.querySelectorAll('[data-i18n-placeholder]');

    if (!animate) {
      els.forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang]?.[key]) el.textContent = translations[lang][key];
      });
      phEls.forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (translations[lang]?.[key]) el.placeholder = translations[lang][key];
      });
      try { localStorage.setItem('lang', lang); } catch {}
      return;
    }

    els.forEach((el) => el.classList.add('i18n-out'));

    setTimeout(() => {
      els.forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang]?.[key]) el.textContent = translations[lang][key];
        el.classList.remove('i18n-out');
      });
      phEls.forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (translations[lang]?.[key]) el.placeholder = translations[lang][key];
      });
      try { localStorage.setItem('lang', lang); } catch {}
    }, 200);
  }

  const globe = document.querySelector('planet-login');
  if (globe) {
    globe.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });

    customElements.whenDefined('planet-login').then(() => {
      setTimeout(() => {
        if (typeof globe.flyTo === 'function') globe.flyTo(2.17, 41.39);
      }, 800);
    });

    globe.addEventListener('locale', (e) => {
      const loc = e.detail;
      const raw = loc.language || '';
      const base = raw.split('-')[0].toLowerCase();
      const lang = langMap[raw] || langMap[base] || 'en';
      setLang(lang, true);
    });
  }

  try {
    const saved = localStorage.getItem('lang');
    if (saved && translations[saved]) setLang(saved, false);
  } catch {}

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
