    zh: { new: '你好，我需要从头开始建一个网站。', improve: '你好，我有一个产品想要改进。', infra: '你好，我需要基础设施方面的帮助。', other: '' },
  };
  const topicCards = document.getElementById('topic-cards');
  const contactForm = document.getElementById('contact-form');
  document.querySelectorAll('.topic-card').forEach((card) => {
    card.addEventListener('click', () => {
      const topic = card.dataset.topic;
      const msg = document.getElementById('message');
      const sel = document.getElementById('topic');
      const lang = currentLang || 'es';
      const pre = topicPrefills[lang] || topicPrefills.es;
      if (msg) msg.value = pre[topic] || '';
      if (sel) {
        const opt = sel.querySelector(`[data-topic="${topic}"]`);
        if (opt) sel.value = opt.value;
      }
      if (!topicCards || !contactForm) return;
      topicCards.classList.add('fading');
      setTimeout(() => {
        topicCards.classList.add('hidden');
        contactForm.classList.add('visible');
        document.querySelector('.contact-heading')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (msg) msg.focus();
      }, 300);
    });
  });

  document.getElementById('contact-back')?.addEventListener('click', () => {
    if (!contactForm || !topicCards) return;
    contactForm.classList.remove('visible');
    topicCards.classList.remove('hidden', 'fading');
  });

  // Footer year
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());

  // Type "ricajos.com" from empty, ".com" in accent
  const typedBase = document.getElementById('typed-base');
  const typedExt = document.getElementById('typed');
  const cursor = document.querySelector('.cursor');
  if (typedBase && typedExt) {
    const base = 'ricajos';
    const ext = '.com';
    let i = 0;
    setTimeout(() => {
      const interval = setInterval(() => {
        if (i < base.length) {
          typedBase.textContent = base.slice(0, i + 1);
        } else {
          typedExt.textContent = ext.slice(0, i - base.length + 1);
        }
        i++;
        if (i === base.length + ext.length) {
          clearInterval(interval);
          setTimeout(() => { if (cursor) cursor.style.display = 'none'; }, 1500);
        }
      }, 100);
    }, 800);
  }
</script>
