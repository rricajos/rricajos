---
import Base from '../layouts/Base.astro';
---

<Base title="ricajos — Ricard Penin Honrubia, desarrollador full-stack en Barcelona">
  <!-- Hero (header lives inside for shared space background) -->
  <section class="hero">
    <header>
      <div class="wrap nav-inner">
        <a href="/" class="logo">ricajos</a>
        <nav>
          <a href="#projects" data-i18n="nav.projects">Proyectos</a>
          <a href="#about" data-i18n="nav.about">Sobre mí</a>
          <a href="#contact" data-i18n="nav.contact">Contacto</a>
        </nav>
      </div>
    </header>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>ricajos<span class="cursor"></span></h1>
        <p class="lead" data-i18n="hero.lead">
          Desarrollador full-stack en Barcelona. Diseño, construyo y despliego
          productos web — del esquema de base de datos al pipeline de deploy.
        </p>
        <a href="#projects" class="cta">
          <span data-i18n="hero.cta">Ver mis proyectos</span>
          <svg
            class="arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg
          >
        </a>
      </div>
      <div class="hero-globe">
        <planet-login accent="#34d399" search="false" remember fly-to-saved data-url="/countries-110m.json"></planet-login>
        <p class="globe-hint" data-i18n="hero.globe_hint">Haz clic en un país para cambiar el idioma</p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <div class="wrap reveal">
      <p class="label" data-i18n="projects.label">Proyectos</p>
      <h2 class="heading" data-i18n="projects.heading">Lo que he construido</h2>
      <div class="grid">
        <div class="card">
          <div class="card-name"><span class="dot"></span>pingunix</div>
          <p class="card-desc" data-i18n="projects.pingunix">
            Plataforma de estudio para la certificación LPIC. 821 páginas de
            contenido con flashcards en PWA.
          </p>
          <div class="tags">
            <span class="tag">Quartz</span>
            <span class="tag">PWA</span>
            <span class="tag">GitHub Pages</span>
          </div>
        </div>
        <div class="card">
          <div class="card-name"><span class="dot"></span>darink</div>
          <p class="card-desc" data-i18n="projects.darink">
            Tracker de salud offline-first. Alimentación, ejercicio, sueño y
            constantes vitales — funciona sin conexión.
          </p>
          <div class="tags">
            <span class="tag">PWA</span>
            <span class="tag">IndexedDB</span>
            <span class="tag">Offline-first</span>
          </div>
        </div>
        <div class="card">
          <div class="card-name"><span class="dot"></span>planetlogin</div>
          <p class="card-desc" data-i18n="projects.planetlogin">
            Portal de autenticación white-label. Login stateless que se integra
            en cualquier app.
          </p>
          <div class="tags">
            <span class="tag">SvelteKit</span>
            <span class="tag">Auth</span>
            <span class="tag">Stateless</span>
          </div>
        </div>
      </div>
      <p class="more" data-i18n="projects.more">Más productos en camino.</p>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="wrap reveal">
      <p class="label" data-i18n="about.label">Sobre mí</p>
      <h2 class="heading" data-i18n="about.heading">Cómo trabajo</h2>
      <div class="two-col">
        <div class="prose">
          <p data-i18n="about.p1">
            Soy Ricard — un desarrollador al que le gusta controlar el panorama
            completo. Mis proyectos corren en infraestructura que gestiono yo,
            desde el clúster Docker Swarm hasta los pipelines CI/CD que
            despliegan código en cada push.
          </p>
          <p data-i18n="about.p2">
            Construyo productos, no solo funcionalidades. Cada proyecto de este
            portfolio lo he concebido, diseñado y desplegado de principio a fin.
            Cuando trabajo con clientes, aplico la misma mentalidad de ownership.
          </p>
        </div>
        <ul class="stack">
          <li>SvelteKit <span class="role">framework</span></li>
          <li>Prisma <span class="role">ORM</span></li>
          <li>PostgreSQL <span class="role" data-i18n="stack.database">base de datos</span></li>
          <li>Docker Swarm <span class="role" data-i18n="stack.orchestration">orquestación</span></li>
          <li>GitHub Actions <span class="role">CI/CD</span></li>
          <li>Linux / VPS <span class="role" data-i18n="stack.infra">infraestructura</span></li>
          <li>Node.js <span class="role">runtime</span></li>
          <li>Python <span class="role">scripting</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section">
    <div class="wrap reveal">
      <h2 class="contact-heading" data-i18n="contact.heading">Construyamos algo.</h2>
      <p class="contact-sub" data-i18n="contact.sub">
        ¿Tienes un proyecto en mente? Abierto a freelance y colaboraciones
        interesantes.
      </p>

      <form
        class="contact-form"
        action="https://formsubmit.co/ergoegos@gmail.com"
        method="POST"
      >
        <input
          type="hidden"
          name="_subject"
          value="New message from ricajos.com"
        />
        <input type="hidden" name="_captcha" value="false" />
        <input
          type="hidden"
          name="_next"
          value="https://ricajos.com/#contact"
        />
        <input
          type="text"
          name="_honey"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <div class="form-row">
          <div class="form-group">
            <label for="name" data-i18n="form.name">Nombre</label>
            <input
              id="name"
              type="text"
              name="name"
              data-i18n-placeholder="form.name_ph"
              placeholder="Tu nombre"
              required
            />
          </div>
          <div class="form-group">
            <label for="email" data-i18n="form.email">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="tu@ejemplo.com"
              data-i18n-placeholder="form.email_ph"
              required
            />
          </div>
        </div>
        <div class="form-group">
          <label for="message" data-i18n="form.message">Mensaje</label>
          <textarea
            id="message"
            name="message"
            data-i18n-placeholder="form.message_ph"
            placeholder="Cuéntame sobre tu proyecto..."
            rows="4"
            required
            maxlength="2000"></textarea>
        </div>
        <button type="submit" class="submit-btn" data-i18n="form.send">Enviar mensaje</button>
      </form>

      <div class="social-links">
        <a href="mailto:ergoegos@gmail.com" target="_blank" rel="noopener"
          >Email</a
        >
        <span class="social-sep">·</span>
        <a href="https://github.com/rricajos" target="_blank" rel="noopener"
          >GitHub</a
        >
        <span class="social-sep">·</span>
        <a href="https://x.com/rricajos" target="_blank" rel="noopener">X</a>
        <span class="social-sep">·</span>
        <a
          href="https://linkedin.com/in/rricajos"
          target="_blank"
          rel="noopener">LinkedIn</a
        >
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="wrap">
      <p>ricajos &mdash; Barcelona</p>
    </div>
  </footer>

  <script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@planetlogin/planetlogin@0.3.0/dist/planetlogin.js"></script>
</Base>

<style>
  .wrap {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Hero (space background) ── */
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #070b16;
    color: #cdd1e4;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1px 1px at 15% 85%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,0.2) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 15%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 95%, rgba(255,255,255,0.15) 0%, transparent 100%),
      radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.3) 0%, transparent 100%);
    pointer-events: none;
  }

  /* ── Nav (inside hero) ── */
  header {
    position: relative;
    z-index: 100;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: #cdd1e4;
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #8b90ad;
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  nav a:hover {
    color: #34d399;
    background: rgba(52, 211, 153, 0.06);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    flex: 1;
    position: relative;
  }

  .hero-text {
    min-width: 0;
  }

  .hero-globe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-globe planet-login {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 420px;
  }

  .globe-hint {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #555978;
    text-align: center;
    font-style: italic;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.78em;
    background: var(--accent);
    margin-left: 0.06em;
    vertical-align: baseline;
    border-radius: 1px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .lead {
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    font-weight: 300;
    color: #8b90ad;
    margin-top: 1.5rem;
    max-width: 520px;
    line-height: 1.55;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #34d399;
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border: 1px solid #34d399;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: #34d399;
    color: #070b16;
  }

  .arrow {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }

  .cta:hover .arrow {
    transform: translateY(2px);
  }

  /* ── Sections ── */
  section {
    padding: 5rem 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .heading {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 2.5rem;
  }

  /* ── Projects ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-hover);
    transform: translateY(-3px);
  }

  .card-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.0625rem;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.175rem 0.45rem;
    border-radius: 4px;
  }

  .more {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── About ── */
  .two-col {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: start;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-2);
  }

  .prose p + p {
    margin-top: 1rem;
  }

  .stack {
    list-style: none;
  }

  .stack li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: 0.5625rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .stack li:first-child {
    border-top: 1px solid var(--border);
  }

  .role {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  /* ── Contact ── */
  .contact-section {
    text-align: center;
    padding: 6rem 0 3rem;
  }

  .contact-heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 0.75rem;
  }

  .contact-sub {
    color: var(--text-2);
    font-size: 1rem;
    margin-bottom: 2.5rem;
  }

  .contact-form {
    max-width: 520px;
    margin: 0 auto;
    text-align: left;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .contact-form label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.375rem;
    letter-spacing: 0.02em;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.15s;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--accent);
    outline: none;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--accent);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover {
    background: var(--accent-hover);
  }

  .social-links {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.15s;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  .social-sep {
    color: var(--muted);
    user-select: none;
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0;
    text-align: center;
  }

  footer p {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-globe planet-login {
      max-width: 320px;
      height: 320px;
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .two-col {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    section {
      padding: 3.5rem 0;
    }
    .contact-section {
      padding: 4rem 0 2.5rem;
    }
    .hero-globe planet-login {
      max-width: 280px;
      height: 280px;
    }
  }

  @media (max-width: 480px) {
    nav a {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
    }
    .logo {
      font-size: 0.9rem;
    }
  }

  /* ── i18n transition ── */
  [data-i18n] {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  [data-i18n].i18n-out {
    opacity: 0;
    transform: translateY(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
    .card,
    .cta,
    nav a,
    .submit-btn,
    [data-i18n] {
      transition: none;
    }
    [data-i18n].i18n-out {
      transform: none;
    }
  }
</style>

