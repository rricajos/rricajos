  const langMap = {
    es: 'es', ca: 'es', gl: 'es', eu: 'es',
    en: 'en',
    zh: 'zh', 'zh-CN': 'zh', 'zh-TW': 'zh',
  };

  let currentLang = 'es';

  function setLang(lang, animate) {
    if (lang === currentLang && animate) return;
    currentLang = lang;
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang;

    const els = document.querySelectorAll('[data-i18n]');
    const phEls = document.querySelectorAll('[data-i18n-placeholder]');

    if (!animate) {
      els.forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang]?.[key]) el.textContent = translations[lang][key];
      });
      phEls.forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (translations[lang]?.[key]) el.placeholder = translations[lang][key];
      });
      try { localStorage.setItem('lang', lang); } catch {}
      return;
    }

    els.forEach((el) => el.classList.add('i18n-out'));

    setTimeout(() => {
      els.forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (translations[lang]?.[key]) el.textContent = translations[lang][key];
        el.classList.remove('i18n-out');
      });
      phEls.forEach((el) => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (translations[lang]?.[key]) el.placeholder = translations[lang][key];
      });
      try { localStorage.setItem('lang', lang); } catch {}
    }, 200);
  }

  // Globe i18n
  const globe = document.querySelector('planet-login');
  if (globe) {
    globe.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });
    globe.addEventListener('locale', (e) => {
      const loc = e.detail;
      const raw = loc.language || '';
      const base = raw.split('-')[0].toLowerCase();
      const lang = langMap[raw] || langMap[base] || 'en';
      setLang(lang, true);
    });
  }

  try {
    const saved = localStorage.getItem('lang');
    if (saved && translations[saved]) setLang(saved, false);
  } catch {}

  // Theme toggle
  function isDark() {
    const dt = document.documentElement.getAttribute('data-theme');
    if (dt === 'dark') return true;
    if (dt === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function updateThemeIcon() {
    const dark = isDark();
    const sun = document.querySelector('.icon-sun');
    const moon = document.querySelector('.icon-moon');
    if (sun) sun.style.display = dark ? 'block' : 'none';
    if (moon) moon.style.display = dark ? 'none' : 'block';
  }

  updateThemeIcon();

  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const newTheme = isDark() ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      try { localStorage.setItem('theme', newTheme); } catch {}
      updateThemeIcon();
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', newTheme === 'dark' ? '#0c0f1a' : '#f3f4f8');
    });
  }

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateThemeIcon);

  // Sticky header
  const header = document.getElementById('site-header');
  const hero = document.querySelector('.hero');

  if (header && hero) {
    const heroObserver = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { threshold: 0, rootMargin: '-52px 0px 0px 0px' }
    );
    heroObserver.observe(hero);
  }

  // Scroll indicator fade
  const scrollIndicator = document.querySelector('.scroll-indicator');
  if (scrollIndicator) {
    window.addEventListener('scroll', () => {
      scrollIndicator.style.opacity = window.scrollY > 80 ? '0' : '1';
    }, { passive: true });
  }

  // Active nav link on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('nav a[data-section]');

  if (sections.length && navLinks.length) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.classList.remove('active'));
            const active = document.querySelector(`nav a[data-section="${entry.target.id}"]`);
            if (active) active.classList.add('active');
          }
        });
      },
      { threshold: 0.15, rootMargin: '-80px 0px -50% 0px' }
    );
    sections.forEach((s) => sectionObserver.observe(s));
  }

  // Reveal on scroll
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

  // Topic cards → reveal form
  const topicPrefills = {
    es: { new: 'Hola, necesito una web desde cero. ', improve: 'Hola, tengo un producto y quiero mejorarlo. ', infra: 'Hola, necesito ayuda con infraestructura. ', other: '' },
