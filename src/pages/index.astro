---
import Base from '../layouts/Base.astro';
---

<Base title="ricajos — Ricard Penin Honrubia, desarrollador full-stack en Barcelona">
  <a href="#projects" class="skip-link" data-i18n="a11y.skip">Ir al contenido</a>

  <header class="site-header" id="site-header">
    <div class="wrap nav-inner">
      <a href="/" class="logo">ricajos</a>
      <div class="nav-right">
        <nav>
          <a href="#projects" data-i18n="nav.projects" data-section="projects">Proyectos</a>
          <a href="#about" data-i18n="nav.about" data-section="about">Sobre mí</a>
          <a href="#contact" data-i18n="nav.contact" data-section="contact">Contacto</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Cambiar tema">
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1><span id="typed-base"></span><span class="typed" id="typed"></span><span class="cursor"></span></h1>
        <p class="lead" data-i18n="hero.lead">
          Diseño, construyo y despliego tu producto multiplataforma. Del primer
          wireframe al servidor en producción, sin intermediarios.
        </p>
        <a href="#contact" class="cta">
          <span data-i18n="hero.cta">Cuéntame tu idea</span>
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
        </a>
      </div>
      <div class="hero-globe">
        <planet-login accent="#34d399" search="false" data-url="/countries-110m.json"></planet-login>
        <p class="globe-hint" data-i18n="hero.globe_hint">Haz clic en un país para cambiar el idioma</p>
      </div>
    </div>
    <div class="scroll-indicator" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </section>

  <section id="projects">
    <div class="wrap reveal">
      <p class="label" data-i18n="projects.label">Proyectos</p>
      <h2 class="heading" data-i18n="projects.heading">Mis proyectos en producción</h2>
      <div class="grid">
        <a href="https://github.com/rricajos/pingunix" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name">pingunix<span class="card-tld">.org</span></div>
            <span class="badge badge-live">live</span>
          </div>
          <p class="card-metric" data-i18n="projects.pingunix_metric">821 páginas · carga instantánea</p>
          <p class="card-desc" data-i18n="projects.pingunix">
            Plataforma de estudio para la certificación LPIC con flashcards
            PWA. Estática, funciona offline y se indexa al completo.
          </p>
          <div class="tags">
            <span class="tag">Quartz</span>
            <span class="tag">PWA</span>
            <span class="tag">GitHub Pages</span>
          </div>
        </a>
        <a href="https://github.com/rricajos/darink" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name">darink<span class="card-tld">.app</span></div>
            <span class="badge badge-wip">wip</span>
          </div>
          <p class="card-metric" data-i18n="projects.darink_metric">100% offline · datos solo en tu dispositivo</p>
          <p class="card-desc" data-i18n="projects.darink">
            Tracker de salud integral: alimentación, ejercicio, sueño y
            constantes vitales. Funciona sin conexión, nada sale de tu móvil.
          </p>
          <div class="tags">
            <span class="tag">PWA</span>
            <span class="tag">IndexedDB</span>
            <span class="tag">Offline-first</span>
          </div>
        </a>
        <a href="https://github.com/rricajos/planetlogin" class="card" target="_blank" rel="noopener">
          <div class="card-header">
            <div class="card-name">planetlogin<span class="card-tld">.org</span></div>
            <span class="badge badge-live">live</span>
          </div>
          <p class="card-metric" data-i18n="projects.planetlogin_metric">En npm · el globo de arriba es este componente</p>
          <p class="card-desc" data-i18n="projects.planetlogin">
            Web component de login con globo interactivo y selector de país.
            Una línea de HTML y tu app tiene autenticación geolocalizada.
          </p>
          <div class="tags">
            <span class="tag">Web Component</span>
            <span class="tag">npm</span>
            <span class="tag">Canvas</span>
          </div>
        </a>
        <a href="/blog/" class="card">
          <div class="card-header">
            <div class="card-name">@rricajos</div>
            <span class="badge badge-live">blog</span>
          </div>
          <p class="card-metric" data-i18n="projects.blog_metric">Artículos técnicos · publicación semanal</p>
          <p class="card-desc" data-i18n="projects.blog">
            Notas técnicas sobre desarrollo web, infraestructura y
            decisiones de producto. Lo que aprendo construyendo.
          </p>
          <div class="tags">
            <span class="tag">Astro</span>
            <span class="tag">GitHub Pages</span>
            <span class="tag">RSS</span>
          </div>
        </a>
      </div>
      <div class="proof">
        <div class="proof-item">
          <span class="proof-num">3</span>
          <span class="proof-label" data-i18n="projects.proof_products">productos en producción</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">821</span>
          <span class="proof-label" data-i18n="projects.proof_pages">páginas publicadas</span>
        </div>
        <div class="proof-item">
          <span class="proof-num">0</span>
          <span class="proof-label" data-i18n="projects.proof_downtime">downtime en deploys</span>
        </div>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap reveal">
      <p class="label" data-i18n="about.label">Sobre mí</p>
      <h2 class="heading" data-i18n="about.heading">De la idea al servidor</h2>
      <div class="about-grid">
        <div class="prose">
          <p data-i18n="about.p1">
            Gestiono mis propios servidores. Eso significa que un
            <code>git push</code> pone tu producto en producción al
            instante, sin depender de nadie.
          </p>
          <p data-i18n="about.p2">
            Los tres proyectos de arriba los hice porque necesitaba algo que
            no existía. Prefiero construir la herramienta a conformarme con
            una que no funciona bien.
          </p>
          <p data-i18n="about.p3">
            Trabajo mejor cuando soy el único responsable. Tú me cuentas la
            idea, yo te entrego el producto con dominio, HTTPS y deploys
            automáticos. Una conversación, no tres equipos.
          </p>
        </div>
        <div class="about-aside">
          <div class="about-block">
            <p class="about-block-label" data-i18n="about.stack_label">Stack principal</p>
            <ul class="stack-compact">
              <li>SvelteKit</li>
              <li>Astro</li>
              <li>Node.js</li>
              <li>PostgreSQL</li>
              <li>Prisma</li>
              <li>Docker Swarm</li>
              <li>Linux / VPS</li>
              <li>GitHub Actions</li>
            </ul>
          </div>
          <div class="about-block">
            <p class="about-block-label" data-i18n="about.also_label">También trabajo con</p>
            <ul class="stack-compact secondary">
              <li>Python</li>
              <li>Go</li>
              <li>PowerShell</li>
              <li>Bash</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap reveal">
      <p class="label" data-i18n="faq.label">FAQ</p>
      <h2 class="heading" data-i18n="faq.heading">Preguntas frecuentes</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary data-i18n="faq.q1">¿Cuánto tarda un proyecto?</summary>
          <p data-i18n="faq.a1">Depende del alcance. Una landing o portfolio, 1-2 semanas. Un producto con backend, auth y base de datos, 4-8 semanas. Te doy una estimación concreta en la propuesta.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="faq.q2">¿Cuánto cuesta?</summary>
          <p data-i18n="faq.a2">Cada proyecto se presupuesta por alcance, no por horas. En la propuesta detallo exactamente qué incluye y cuánto cuesta. Sin sorpresas ni costes ocultos.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="faq.q3">¿Cómo funciona?</summary>
          <p data-i18n="faq.a3">Rellenas el formulario de abajo. En 48h te contesto para entender el alcance. Te envío una propuesta cerrada con precio, tecnología y calendario. Desarrollamos con entregas visibles en una URL de staging. Deploy a producción y handoff completo.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="faq.q4">¿Qué pasa después de la entrega?</summary>
          <p data-i18n="faq.a4">Te entrego el producto funcionando con documentación para mantenerlo. Si necesitas mantenimiento continuo, lo hablamos aparte. No desaparezco después del deploy.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="faq.q5">¿El código es mío?</summary>
          <p data-i18n="faq.a5">Sí. Trabajamos en tu repositorio desde el día uno. Tú eres el dueño del código, el dominio y la infraestructura. Cero dependencia de mí.</p>
        </details>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="wrap">
      <p class="label" data-i18n="contact.label">Contacto</p>
      <h2 class="contact-heading" data-i18n="contact.heading">¿Tienes un proyecto en mente?</h2>
      <p class="contact-sub" data-i18n="contact.sub">
        Cuéntame qué necesitas. En 48h te respondo con una propuesta
        concreta: alcance, tecnología y calendario.
      </p>
      <div class="contact-stage" id="contact-stage">
      <div class="topic-cards" id="topic-cards">
        <button class="topic-card" data-topic="new">
          <svg class="topic-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span class="topic-label" data-i18n="topic.new">Web desde cero</span>
          <span class="topic-desc" data-i18n="topic.new_desc">Nuevo producto completo</span>
        </button>
        <button class="topic-card" data-topic="improve">
          <svg class="topic-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span class="topic-label" data-i18n="topic.improve">Mejorar mi producto</span>
          <span class="topic-desc" data-i18n="topic.improve_desc">Evolucionar algo que ya existe</span>
        </button>
        <button class="topic-card" data-topic="infra">
          <svg class="topic-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
          <span class="topic-label" data-i18n="topic.infra">Infraestructura</span>
          <span class="topic-desc" data-i18n="topic.infra_desc">Servidores, deploys, CI/CD</span>
        </button>
        <button class="topic-card" data-topic="other">
          <svg class="topic-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="topic-label" data-i18n="topic.other">Otro</span>
          <span class="topic-desc" data-i18n="topic.other_desc">Consulta abierta</span>
        </button>
      </div>
      <form class="contact-form" id="contact-form" action="https://formsubmit.co/ergoegos@gmail.com" method="POST">
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://ricajos.com/thanks" />
        <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="button" class="form-back" id="contact-back">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span data-i18n="form.back">Cambiar tema</span>
        </button>
        <div class="form-group">
          <label for="topic" data-i18n="form.topic">Asunto</label>
          <select id="topic" name="_subject" required>
            <option value="" data-i18n="form.topic_ph">Selecciona un tema</option>
            <option value="Web desde cero" data-i18n="topic.new" data-topic="new">Web desde cero</option>
            <option value="Mejorar mi producto" data-i18n="topic.improve" data-topic="improve">Mejorar mi producto</option>
            <option value="Infraestructura" data-i18n="topic.infra" data-topic="infra">Infraestructura</option>
            <option value="Otro" data-i18n="topic.other" data-topic="other">Otro</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="name" data-i18n="form.name">Nombre</label>
            <input id="name" type="text" name="name" data-i18n-placeholder="form.name_ph" placeholder="Tu nombre" required />
          </div>
          <div class="form-group">
            <label for="email" data-i18n="form.email">Email</label>
            <input id="email" type="email" name="email" placeholder="tu@ejemplo.com" data-i18n-placeholder="form.email_ph" required />
          </div>
        </div>
        <div class="form-group">
          <label for="message" data-i18n="form.message">Mensaje</label>
          <textarea id="message" name="message" data-i18n-placeholder="form.message_ph" placeholder="Cuéntame sobre tu proyecto..." rows="4" required maxlength="2000"></textarea>
        </div>
        <button type="submit" class="submit-btn" data-i18n="form.send">Enviar mensaje</button>
      </form>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <a href="#" class="footer-logo">ricajos<span class="footer-tld">.com</span></a>
        <span class="footer-copy">&copy; <span id="year"></span> Ricard Penin Honrubia</span>
        <p class="footer-desc" data-i18n="footer.desc">Diseño, construyo y despliego productos multiplataforma de principio a fin.</p>
        <div class="footer-social">
          <a href="https://github.com/rricajos" target="_blank" rel="noopener" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://instagram.com/rricajos" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://linkedin.com/in/rricajos" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h4 class="footer-heading" data-i18n="footer.nav_heading">Navegación</h4>
        <ul>
          <li><a href="#projects" data-i18n="nav.projects">Proyectos</a></li>
          <li><a href="#about" data-i18n="nav.about">Sobre mí</a></li>
          <li><a href="/blog/" data-i18n="nav.blog">Blog</a></li>
          <li><a href="#contact" data-i18n="nav.contact">Contacto</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-heading" data-i18n="footer.projects_heading">Proyectos</h4>
        <ul>
          <li><a href="https://pingunix.org" target="_blank" rel="noopener">pingunix.org</a></li>
          <li><a href="https://darink.app" target="_blank" rel="noopener">darink.app</a></li>
          <li><a href="https://planetlogin.org" target="_blank" rel="noopener">planetlogin.org</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4 class="footer-heading" data-i18n="footer.legal_heading">Legal</h4>
        <ul>
          <li><a href="/privacy" data-i18n="footer.privacy">Privacidad</a></li>
          <li><a href="/terms" data-i18n="footer.terms">Términos</a></li>
          <li><a href="mailto:ergoegos@gmail.com" data-i18n="footer.support">Soporte</a></li>
        </ul>
      </div>
    </div>
  </footer>

  <script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@planetlogin/planetlogin@0.3.0/dist/planetlogin.js"></script>
</Base>

<style>
  .wrap {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Skip link ── */
  .skip-link {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 10000;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--bg);
    background: var(--accent);
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }

  /* ── Fixed header ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .site-header.scrolled {
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  .site-header:not(.scrolled) {
    --text: #cdd1e4;
    --text-2: #8b90ad;
    --accent: #34d399;
    --accent-soft: rgba(52, 211, 153, 0.06);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.25rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.03em;
    transition: color 0.3s;
  }

  nav {
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }

  nav a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  nav a.active {
    color: var(--accent);
  }

  /* ── Theme toggle ── */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    background: none;
    color: var(--text-2);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .theme-toggle:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .icon-sun,
  .icon-moon {
    display: none;
  }

  /* ── Hero (always dark — override theme tokens locally) ── */
  .hero {
    --bg: #070b16;
    --text: #cdd1e4;
    --text-2: #8b90ad;
    --muted: #6d728f;
    --accent: #34d399;
    --accent-hover: #6ee7b7;
    --accent-soft: rgba(52, 211, 153, 0.06);
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--bg);
    color: var(--text);
    position: relative;
    overflow: hidden;
    padding: 3.25rem 0 0;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.25) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 40%, rgba(255,255,255,0.35) 0%, transparent 100%),
      radial-gradient(1px 1px at 15% 85%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 45%, rgba(255,255,255,0.2) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 15%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 40% 95%, rgba(255,255,255,0.15) 0%, transparent 100%),
      radial-gradient(1px 1px at 25% 35%, rgba(255,255,255,0.3) 0%, transparent 100%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 2rem;
    align-items: center;
    flex: 1;
    position: relative;
  }

  .hero-text {
    min-width: 0;
  }

  .hero-globe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    position: relative;
  }

  .hero-globe planet-login {
    display: block;
    width: 100%;
    max-width: 550px;
    height: 550px;
  }

  .globe-hint {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    text-align: center;
    font-style: italic;
    opacity: 0;
    transition: opacity 0.3s ease;
    margin-top: 0.25rem;
  }

  .hero-globe:hover .globe-hint {
    opacity: 1;
  }

  .hero-globe planet-login > :global(a[href*="ricajos"]) {
    display: none !important;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .typed {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 3px;
    height: 0.78em;
    background: var(--accent);
    margin-left: 0.06em;
    vertical-align: baseline;
    border-radius: 1px;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .lead {
    font-size: clamp(1.0625rem, 2.2vw, 1.375rem);
    font-weight: 300;
    color: var(--text-2);
    margin-top: 1.5rem;
    max-width: 520px;
    line-height: 1.55;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    padding: 0.5rem 1.125rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
  }

  .cta:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .arrow {
    width: 13px;
    height: 13px;
    transition: transform 0.2s;
  }

  .cta:hover .arrow {
    transform: translateY(2px);
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    animation: bounce 2.5s ease infinite;
    transition: opacity 0.4s;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  /* ── Hero entrance animation ── */
  .hero-text > * {
    opacity: 0;
    animation: heroIn 0.7s ease forwards;
  }

  .hero-text h1 { animation-delay: 0s; }
  .hero-text .lead { animation-delay: 0.15s; }
  .hero-text .cta { animation-delay: 0.3s; }

  .hero-globe {
    opacity: 0;
    animation: heroIn 0.8s ease 0.1s forwards;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Sections ── */
  section {
    padding: 5rem 0;
  }

  section[id] {
    scroll-margin-top: 4rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .heading {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 2.5rem;
  }

  /* ── Projects ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .grid .card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-hover);
    transform: translateY(-3px);
  }

  .card::after {
    content: '↗';
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .card:hover::after {
    opacity: 1;
  }

  .card:visited {
    color: inherit;
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 10px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.0625rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-tld {
    color: var(--accent);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.125rem 0.5rem;
    border-radius: 99px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .badge-live {
    color: var(--accent);
    background: rgba(52, 211, 153, 0.1);
  }

  .badge-wip {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
  }

  .card-metric {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--text-2);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.175rem 0.45rem;
    border-radius: 4px;
  }

  .proof {
    display: flex;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .proof-num {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .proof-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── About ── */
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: start;
  }

  .prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-2);
  }

  .prose p + p {
    margin-top: 1rem;
  }

  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .about-block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.625rem;
  }

  .stack-compact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .stack-compact li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.625rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
  }

  .stack-compact.secondary li {
    color: var(--text-2);
  }

  /* ── FAQ ── */
  .faq-list {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  .faq-item[open] {
    border-color: var(--accent);
  }

  .faq-item summary {
    padding: 1rem 1.25rem;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    transition: color 0.2s;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--accent);
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item summary:hover {
    color: var(--accent);
  }

  .faq-item p {
    padding: 0 1.25rem 1rem;
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.65;
  }

  /* ── Contact ── */
  .contact-section {
    text-align: center;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 0 4rem;
    background: var(--accent-soft);
    border-top: 1px solid var(--border);
  }

  .contact-section > .wrap {
    width: 100%;
  }

  .contact-heading {
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 0.5rem;
  }

  .contact-sub {
    color: var(--text-2);
    font-size: 1rem;
    margin-bottom: 1.75rem;
  }

  .topic-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 640px;
    margin: 0 auto;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .topic-cards.fading {
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
  }

  .topic-cards.hidden {
    display: none;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: var(--font-sans);
  }

  .topic-card:hover {
    border-color: var(--accent);
    box-shadow: var(--card-hover);
  }

  .topic-icon {
    color: var(--accent);
  }

  .topic-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }

  .topic-desc {
    font-size: 0.6875rem;
    color: var(--muted);
    line-height: 1.3;
  }

  .contact-form {
    display: none;
    max-width: 520px;
    margin: 0 auto;
    text-align: left;
  }

  .contact-form.visible {
    display: block;
    animation: fadeInUp 0.35s ease;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-bottom: 1.25rem;
    transition: color 0.2s;
  }

  .form-back:hover {
    color: var(--accent);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .contact-form label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.375rem;
    letter-spacing: 0.02em;
  }

  .contact-form select,
  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.15s;
  }

  .contact-form select:focus,
  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--accent);
    outline: none;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--bg);
    background: var(--accent);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover {
    background: var(--accent-hover);
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
  }

  .footer-tld {
    color: var(--accent);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .footer-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 260px;
  }

  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--muted);
    transition: background 0.2s, color 0.2s;
  }

  .footer-social a:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-heading {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 0.875rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col ul li {
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .footer-col ul li a {
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-col ul li a:hover {
    color: var(--accent);
  }



  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero {
      min-height: 100dvh;
      padding-bottom: 0;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 1rem;
      padding-top: 1rem;
    }
    .hero-text {
      text-align: center;
      order: 2;
    }
    .hero-globe {
      order: 1;
      justify-content: center;
    }
    .globe-hint {
      opacity: 0.6;
    }
    .lead {
      margin-left: auto;
      margin-right: auto;
    }
    .cta {
      margin-top: 1.25rem;
    }
    h1 {
      font-size: clamp(2rem, 8vw, 3rem);
    }
    .hero-globe planet-login {
      max-width: min(500px, 80vw);
      height: min(500px, 80vw);
    }
    nav a {
      padding: 0.5rem 0.75rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
    .scroll-indicator {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
    .topic-cards {
      grid-template-columns: repeat(2, 1fr);
    }
    section {
