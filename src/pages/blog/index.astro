---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Blog — ricajos" description="Artículos sobre desarrollo web, DevOps y emprendimiento por Ricard Penin Honrubia.">
  <div class="page">
    <a href="/" class="back" id="back">&larr; ricajos.com</a>
    <h1 id="title">Blog</h1>
    <p class="intro" id="intro">Notas sobre desarrollo web, infraestructura y lo que aprendo por el camino.</p>

    {posts.length === 0 && (
      <p class="empty" id="empty">Todav&iacute;a no hay publicaciones. Vuelve pronto.</p>
    )}

    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="post-link">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {post.data.pubDate.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="tags">
              {post.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back:hover {
    opacity: 0.7;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
    letter-spacing: -0.03em;
  }

  .intro {
    color: var(--text-2);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .empty {
    color: var(--muted);
    font-style: italic;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-link {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .post-link:hover {
    border-color: var(--accent);
    box-shadow: var(--card-hover);
  }

  .post-link time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-link h2 {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
    margin: 0.35rem 0 0.25rem;
    line-height: 1.35;
  }

  .post-link p {
    font-size: 0.875rem;
    color: var(--text-2);
    line-height: 1.5;
    margin: 0;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
</style>
