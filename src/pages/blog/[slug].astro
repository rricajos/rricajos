---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog')).filter((p) => p.data.pubDate <= now);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const pubDate = post.data.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base title={`${post.data.title} — ricajos`} description={post.data.description}>
  <article class="page">
    <a href="/blog/" class="back">&larr; Blog</a>
    <header>
      <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{pubDate}</time>
      <h1>{post.data.title}</h1>
      <div class="tags">
        {post.data.tags.map((tag: string) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <a href="/blog/" class="back back-bottom">&larr; Volver al blog</a>
  </article>
</Base>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding: 6rem 1.5rem 4rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back:hover {
    opacity: 0.7;
  }

  .back-bottom {
    display: inline-block;
    margin-top: 3rem;
  }

  header {
    margin: 1.5rem 0 2.5rem;
  }

  header time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  header h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--tag-text);
    background: var(--tag-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .prose {
    line-height: 1.8;
    color: var(--text);
  }

  .prose :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 2rem 0 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--text-2);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .prose :global(a:hover) {
    text-decoration: underline;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-2);
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: var(--text);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }
</style>
