---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ricajos — Ricard Penin Honrubia, desarrollador full-stack en Barcelona',
  description = 'Ricard Penin Honrubia (ricajos) — Desarrollador web full-stack en Barcelona. Diseño, construyo y despliego productos web de principio a fin.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Ricard Penin Honrubia, ricajos, desarrollador web Barcelona, full-stack developer, programador Barcelona, portfolio desarrollador" />
    <meta name="author" content="Ricard Penin Honrubia" />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/avatar.png" />
    <meta name="theme-color" content="#0c0f1a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://ricajos.com/avatar.png" />
    <meta property="og:url" content="https://ricajos.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@rricajos" />
    <link rel="canonical" href="https://ricajos.com/" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Ricard Penin Honrubia',
        alternateName: ['ricajos', 'Ricard Penin'],
        jobTitle: 'Desarrollador Full-stack',
        description: 'Desarrollador web full-stack en Barcelona. Diseño, construyo y despliego productos web de principio a fin.',
        url: 'https://ricajos.com/',
        image: 'https://ricajos.com/avatar.png',
        sameAs: [
          'https://github.com/rricajos',
          'https://x.com/rricajos',
          'https://linkedin.com/in/rricajos',
        ],
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Barcelona',
          addressCountry: 'ES',
        },
        knowsAbout: [
          'SvelteKit',
          'Astro',
          'Docker Swarm',
          'PostgreSQL',
          'Node.js',
          'Go',
          'Linux',
        ],
      })}
    />

    <script is:inline>
      (function(){try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}})();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f4f8;
    --surface: #ffffff;
    --text: #1b1f33;
    --text-2: #4a5072;
    --muted: #878da8;
    --accent: #0a7b5a;
    --accent-hover: #065e44;
    --accent-soft: rgba(10, 123, 90, 0.06);
    --tag-text: #5b5fc7;
    --tag-bg: rgba(91, 95, 199, 0.07);
    --border: #dcdee8;
    --dot: rgba(27, 31, 51, 0.04);
    --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.03);
    --card-hover: 0 8px 24px rgba(0, 0, 0, 0.07);
    --nav-bg: rgba(243, 244, 248, 0.82);
    --font-mono: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace;
    --font-sans: 'Outfit', system-ui, -apple-system, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0c0f1a;
      --surface: #151929;
      --text: #cdd1e4;
      --text-2: #8b90ad;
      --muted: #555978;
      --accent: #34d399;
      --accent-hover: #6ee7b7;
      --accent-soft: rgba(52, 211, 153, 0.06);
      --tag-text: #a5b4fc;
      --tag-bg: rgba(165, 180, 252, 0.06);
      --border: #1e2340;
      --dot: rgba(255, 255, 255, 0.025);
      --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.15);
      --card-hover: 0 8px 24px rgba(0, 0, 0, 0.3);
      --nav-bg: rgba(12, 15, 26, 0.82);
    }
  }

  :root[data-theme='dark'] {
    --bg: #0c0f1a;
    --surface: #151929;
    --text: #cdd1e4;
    --text-2: #8b90ad;
    --muted: #555978;
    --accent: #34d399;
    --accent-hover: #6ee7b7;
    --accent-soft: rgba(52, 211, 153, 0.06);
    --tag-text: #a5b4fc;
    --tag-bg: rgba(165, 180, 252, 0.06);
    --border: #1e2340;
    --dot: rgba(255, 255, 255, 0.025);
    --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.15);
    --card-hover: 0 8px 24px rgba(0, 0, 0, 0.3);
    --nav-bg: rgba(12, 15, 26, 0.82);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
